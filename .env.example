# Plain configuration only. Passwords and keys live in secrets/ (created by `make env`, git-ignored):
# blt_password, postgres_password, django_secret_key, minio_root_password, minio_ro_secret,
# opencode_api_key (empty = AI off) and email_host_password.

# Runtime
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,web
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: sqlite for zero-setup local runs, postgres for Compose.
DB_ENGINE=sqlite
POSTGRES_DB=blt
POSTGRES_USER=blt
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis/Celery. Leave REDIS_URL empty to use local memory cache.
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=true
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Email: console locally, Mailpit through Compose.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=BLT <no-reply@blt.local>

# Storage: filesystem or s3 (MinIO profile)
STORAGE_BACKEND=filesystem
S3_ENDPOINT=http://127.0.0.1:9200
S3_BUCKET=blt-media
S3_ACCESS_KEY=bltminio
# Read-only MinIO user created by minio-init (used by the BLT MinIO MCP).
MINIO_RO_ACCESS_KEY=bltminio-ro
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

# Generative AI (fixed task: spec from issue). The key goes in secrets/opencode_api_key.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_TIMEOUT=45
SPEC_MAX_INPUT_CHARS=12000

# Gitea: local issue tracker used by the spec flow.
GITEA_URL=http://localhost:3000
GITEA_API_URL=http://localhost:3000/api/v1
GITEA_USER=blt
# The Gitea web login is GITEA_EMAIL plus secrets/blt_password, the same password as the seeded
# BLT users; ballast and lane get it in Gitea too.
GITEA_REPO=blt/tasks
# Comma-separated repos the app may read or publish to. Defaults to GITEA_REPO.
GITEA_ALLOWED_REPOS=blt/tasks
GITEA_EMAIL=blt@mail.com

# Ports published by Compose
API_PORT=8000
WEB_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
