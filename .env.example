# Runtime
DEBUG=true
SECRET_KEY=django-insecure-local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,api,web
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: sqlite for zero-setup local runs, postgres for Compose/CI.
DB_ENGINE=sqlite
POSTGRES_DB=blt
POSTGRES_USER=blt
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis/Celery. Leave REDIS_URL empty to use local memory cache.
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=true
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Email: console locally, Mailpit through Compose.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=BLT <no-reply@blt.local>

# Storage: filesystem or s3 (MinIO profile)
STORAGE_BACKEND=filesystem
S3_ENDPOINT=http://127.0.0.1:9200
S3_BUCKET=blt-media
S3_ACCESS_KEY=bltminio
S3_SECRET_KEY=change-this-local-minio-password
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

# Ports published by Compose
API_PORT=8000
WEB_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
GUNICORN_WORKERS=3
