# One shot: creates the Gitea repository and issues, then stops (restart policy NEVER; redeploy to run again).
SERVICE_ROLE=seed
DEBUG=false
DJANGO_SECRET_KEY=${{api.DJANGO_SECRET_KEY}}
BLT_PASSWORD=${{api.BLT_PASSWORD}}
GITEA_API_URL=http://${{gitea.RAILWAY_PRIVATE_DOMAIN}}:3000/api/v1
GITEA_URL=https://${{gitea.RAILWAY_PUBLIC_DOMAIN}}
GITEA_USER=blt
GITEA_REPO=blt/tasks
