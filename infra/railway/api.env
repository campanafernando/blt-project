# The API: migrations and the seed run when it starts, then gunicorn. Private: only web reaches it.
# DJANGO_SECRET_KEY, BLT_PASSWORD and OPENCODE_API_KEY are secrets: deploy.py sends them on stdin.
SERVICE_ROLE=api
PORT=8000
RUN_MIGRATIONS=1
SEED_DATA=1
# Not called HTTPS_PROXY: pip and curl read that name as a proxy address and the image build breaks.
TRUST_FORWARDED_PROTO=true
# Railway's edge and nginx: the rate limits then count the client's address.
NUM_PROXIES=2
WEB_CONCURRENCY=2
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_TIMEOUT=45
SPEC_MAX_INPUT_CHARS=12000
ALLOWED_HOSTS=${{web.RAILWAY_PUBLIC_DOMAIN}},${{api.RAILWAY_PRIVATE_DOMAIN}},healthcheck.railway.app
CSRF_TRUSTED_ORIGINS=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
GITEA_API_URL=http://${{gitea.RAILWAY_PRIVATE_DOMAIN}}:3000/api/v1
GITEA_URL=https://${{gitea.RAILWAY_PUBLIC_DOMAIN}}
GITEA_USER=blt
GITEA_REPO=blt/tasks
